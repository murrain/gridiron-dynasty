{
  "offensive_schemes": {
    "west_coast": {
      "philosophy": "Short timing routes and YAC. Prizes accuracy over arm strength. TEs and RBs must be receivers first, blockers second. WRs run precise routes rather than burning defenders deep.",
      "roster_requirements": {
        "ideal_depth": { "WR": 6, "RB": 4, "TE": 3, "OL": 9 },
        "minimum_depth": { "WR": 5, "RB": 3, "TE": 2 }
      },
      "position_stat_weights": {
        "QB": {
          "throw_accuracy": 1.3,
          "throw_power": 0.8
        },
        "TE": {
          "catching": 1.3,
          "route_running": 1.25,
          "blocking": 0.7
        },
        "RB": {
          "catching": 1.3,
          "route_running": 1.2
        },
        "WR": {
          "route_running": 1.25,
          "speed": 0.8
        }
      }
    },

    "power_run": {
      "philosophy": "Smashmouth football. TEs are extra linemen, not pass catchers. WRs block on the perimeter. OL wins with brute strength, not finesse. QB mobility is irrelevant - hand the ball off and manage the game.",
      "roster_requirements": {
        "ideal_depth": { "WR": 5, "RB": 4, "TE": 4, "OL": 10 },
        "minimum_depth": { "WR": 4, "RB": 3, "TE": 3 }
      },
      "position_stat_weights": {
        "QB": {
          "speed": 0.7,
          "agility": 0.7
        },
        "TE": {
          "blocking": 1.4,
          "strength": 1.3,
          "catching": 0.7,
          "route_running": 0.6
        },
        "RB": {
          "strength": 1.3,
          "balance": 1.2,
          "catching": 0.75
        },
        "WR": {
          "blocking": 1.3,
          "speed": 0.8
        },
        "OL": {
          "strength": 1.25,
          "agility": 0.8
        }
      }
    },

    "spread_option": {
      "philosophy": "QB as a runner creates numbers advantages. Dual-threat QB is mandatory - pocket passers need not apply. Speed over power everywhere. Athletic OL who can pull and get to the second level.",
      "roster_requirements": {
        "ideal_depth": { "WR": 6, "RB": 3, "TE": 2, "OL": 9 },
        "minimum_depth": { "WR": 5, "RB": 2, "TE": 2 }
      },
      "position_stat_weights": {
        "QB": {
          "speed": 1.35,
          "agility": 1.3,
          "throw_power": 0.8
        },
        "TE": {
          "speed": 1.2,
          "blocking": 0.75
        },
        "RB": {
          "speed": 1.25,
          "agility": 1.2,
          "strength": 0.8
        },
        "WR": {
          "blocking": 1.2
        },
        "OL": {
          "agility": 1.2,
          "strength": 0.85
        }
      }
    },

    "air_raid": {
      "philosophy": "Chuck it deep. QB needs a cannon arm but doesn't need to run. TEs are glorified receivers - blocking is an afterthought. Stock up on WRs who can stretch the field. RBs catch passes out of the backfield.",
      "roster_requirements": {
        "ideal_depth": { "WR": 7, "RB": 3, "TE": 2, "OL": 9 },
        "minimum_depth": { "WR": 6, "RB": 2, "TE": 2 }
      },
      "position_stat_weights": {
        "QB": {
          "throw_power": 1.35,
          "throw_accuracy": 1.25,
          "speed": 0.75
        },
        "TE": {
          "speed": 1.3,
          "catching": 1.25,
          "blocking": 0.6,
          "strength": 0.7
        },
        "WR": {
          "speed": 1.3,
          "catching": 1.2
        },
        "RB": {
          "catching": 1.25,
          "strength": 0.8
        }
      }
    },

    "zone_run": {
      "philosophy": "Outside zone and cutback lanes. RBs need vision and patience, not just power. OL must be athletic enough to reach the second level - maulers need not apply. Everyone blocks on the perimeter.",
      "roster_requirements": {
        "ideal_depth": { "WR": 5, "RB": 4, "TE": 3, "OL": 10 },
        "minimum_depth": { "WR": 4, "RB": 3, "TE": 2 }
      },
      "position_stat_weights": {
        "TE": {
          "blocking": 1.2,
          "agility": 1.2
        },
        "RB": {
          "agility": 1.3,
          "awareness": 1.25,
          "strength": 0.8
        },
        "WR": {
          "blocking": 1.2
        },
        "OL": {
          "agility": 1.3,
          "speed": 1.2,
          "strength": 0.8
        }
      }
    },

    "pro_style": {
      "philosophy": "Balanced attack with no strong preferences. Adaptable to personnel. Jack of all trades, master of none - won't maximize any player type but won't waste anyone either.",
      "roster_requirements": {
        "ideal_depth": { "WR": 6, "RB": 4, "TE": 3, "OL": 9 },
        "minimum_depth": { "WR": 5, "RB": 3, "TE": 2 }
      },
      "position_stat_weights": {}
    }
  },

  "defensive_schemes": {
    "4_3_under": {
      "philosophy": "Pin ears back and rush the passer. EDGEs are pure pass rushers - run defense is secondary. LBs must cover, not just thump. Aggressive, attacking front that gambles on getting to the QB.",
      "roster_requirements": {
        "ideal_depth": { "DL": 7, "EDGE": 4, "LB": 5, "CB": 5, "S": 4 },
        "minimum_depth": { "DL": 6, "EDGE": 3, "LB": 4 }
      },
      "position_stat_weights": {
        "EDGE": {
          "pass_rush": 1.35,
          "acceleration": 1.25,
          "run_defense": 0.8
        },
        "DL": {
          "pass_rush": 1.25,
          "acceleration": 1.2
        },
        "LB": {
          "coverage": 1.3,
          "speed": 1.2,
          "strength": 0.8
        }
      }
    },

    "3_4_two_gap": {
      "philosophy": "Massive DL who eat blocks and free up LBs. DL are anchors, not pass rushers - strength over speed. OLBs must be versatile, not just sack specialists. LBs are downhill thumpers, not coverage players.",
      "roster_requirements": {
        "ideal_depth": { "DL": 5, "EDGE": 5, "LB": 7, "CB": 5, "S": 4 },
        "minimum_depth": { "DL": 4, "EDGE": 4, "LB": 6 }
      },
      "position_stat_weights": {
        "EDGE": {
          "coverage": 1.2,
          "pass_rush": 0.8
        },
        "DL": {
          "strength": 1.4,
          "run_defense": 1.35,
          "pass_rush": 0.7,
          "speed": 0.7
        },
        "LB": {
          "tackling": 1.25,
          "strength": 1.2,
          "coverage": 0.8
        }
      }
    },

    "cover_2": {
      "philosophy": "Zone coverage with split safeties. CBs must tackle - they play the flats, not deep. LBs need range to cover the middle, sacrificing size. Safeties read and react rather than freelancing.",
      "roster_requirements": {
        "ideal_depth": { "DL": 6, "EDGE": 4, "LB": 6, "CB": 5, "S": 4 },
        "minimum_depth": { "DL": 5, "EDGE": 3, "LB": 5 }
      },
      "position_stat_weights": {
        "CB": {
          "tackling": 1.3,
          "awareness": 1.2,
          "press_coverage": 0.75
        },
        "S": {
          "coverage": 1.3,
          "awareness": 1.2
        },
        "LB": {
          "coverage": 1.35,
          "speed": 1.25,
          "strength": 0.75
        }
      }
    },

    "cover_3": {
      "philosophy": "Single high safety covers the deep middle. CBs play deep thirds - must have range. Free safety is the last line of defense, prioritizing speed and coverage over tackling. LBs handle underneath zones.",
      "roster_requirements": {
        "ideal_depth": { "DL": 6, "EDGE": 4, "LB": 6, "CB": 5, "S": 4 },
        "minimum_depth": { "DL": 5, "EDGE": 3, "LB": 5 }
      },
      "position_stat_weights": {
        "CB": {
          "coverage": 1.3,
          "speed": 1.2
        },
        "S": {
          "speed": 1.35,
          "coverage": 1.3,
          "tackling": 0.8
        },
        "LB": {
          "coverage": 1.2
        }
      }
    },

    "press_man": {
      "philosophy": "Get physical at the line and stick to receivers. CBs need strength and speed to jam and run with anyone. Aggressive, high-risk/high-reward. Zone awareness doesn't matter - just don't get beat by your man.",
      "roster_requirements": {
        "ideal_depth": { "DL": 6, "EDGE": 4, "LB": 5, "CB": 6, "S": 4 },
        "minimum_depth": { "DL": 5, "EDGE": 3, "LB": 4, "CB": 5 }
      },
      "position_stat_weights": {
        "CB": {
          "press_coverage": 1.4,
          "speed": 1.25,
          "strength": 1.2,
          "awareness": 0.75
        },
        "S": {
          "speed": 1.25,
          "tackling": 1.2,
          "awareness": 0.8
        }
      }
    },

    "tampa_2": {
      "philosophy": "Cover 2 with an athletic MLB who can run with TEs down the seam. LBs must be freakishly fast, sacrificing traditional size and tackling ability. CBs funnel everything inside and make tackles in the flat.",
      "roster_requirements": {
        "ideal_depth": { "DL": 6, "EDGE": 4, "LB": 6, "CB": 5, "S": 4 },
        "minimum_depth": { "DL": 5, "EDGE": 3, "LB": 5 }
      },
      "position_stat_weights": {
        "LB": {
          "speed": 1.4,
          "coverage": 1.35,
          "strength": 0.7,
          "tackling": 0.8
        },
        "CB": {
          "tackling": 1.25,
          "press_coverage": 0.7
        },
        "S": {
          "coverage": 1.25,
          "awareness": 1.2
        }
      }
    },

    "aggressive_blitz": {
      "philosophy": "Bring pressure from everywhere and live with the consequences. LBs and DBs must be able to rush, sacrificing zone awareness. Feast or famine - get sacks or give up big plays. Not for the faint of heart.",
      "roster_requirements": {
        "ideal_depth": { "DL": 6, "EDGE": 5, "LB": 7, "CB": 5, "S": 4 },
        "minimum_depth": { "DL": 5, "EDGE": 4, "LB": 6 }
      },
      "position_stat_weights": {
        "LB": {
          "pass_rush": 1.3,
          "acceleration": 1.25
        },
        "CB": {
          "press_coverage": 1.25,
          "awareness": 0.8
        },
        "S": {
          "tackling": 1.25,
          "awareness": 0.8
        },
        "EDGE": {
          "pass_rush": 1.3,
          "acceleration": 1.2
        },
        "DL": {
          "pass_rush": 1.25,
          "acceleration": 1.2
        }
      }
    }
  },

