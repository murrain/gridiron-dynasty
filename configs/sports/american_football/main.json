                "premium": {
                    "positions": ["QB", "EDGE", "OL", "CB"],
                    "round_1_bonus": 1.4,
                    "round_2_bonus": 1.3,
                    "round_3_bonus": 1.15,
                    "round_4_plus_bonus": 1.0
